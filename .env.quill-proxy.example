# quill-proxy/.env.local — Apex Integration (Server-Side Only)
#
# This file shows how to wire Apex into your quill-proxy routes.
# Copy these keys from ./manage_keys.py output (they are tier-specific).
#
# SECURITY: These are secret API keys. Keep them in .env.local only.
#           Never commit them to git.

# ─────────────────────────────────────────────────────────────────────────────
# Apex Backend URL (Production)
# ─────────────────────────────────────────────────────────────────────────────
APEX_BASE_URL=https://your-apex-production-host.railway.app

# ─────────────────────────────────────────────────────────────────────────────
# Tier-Specific API Keys
# ─────────────────────────────────────────────────────────────────────────────
# These keys enforce quotas at the Apex level:
#
#   Free Tier:     10 requests/day, 5,000 tokens/day
#   Pro Tier:      1,000 requests/day, 500,000 tokens/day
#   Internal Tier: Unlimited (for dev/testing)
#
# In your route handler, select the key based on user subscription:
#
#   const key = userTier === 'pro' 
#     ? process.env.APEX_KEY_PRO_TIER 
#     : process.env.APEX_KEY_FREE_TIER;
#
# If a user hits their quota, Apex returns HTTP 429 and a clear message.

APEX_KEY_FREE_TIER=apx_4f6421b270f8b17cef41555938b58264
APEX_KEY_PRO_TIER=apx_493f177847c00cd899741e5a2dbc40cb
APEX_KEY_INTERNAL=apx_33c15a1be8a8a8b94eaf6e9032ccb843

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Override keys for local dev (Ollama, LM Studio, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank or comment out for production.

# APEX_BASE_URL_DEV=http://127.0.0.1:8000
# APEX_KEY_DEV=apx_your_local_test_key

# ─────────────────────────────────────────────────────────────────────────────
# How to Implement in quill-proxy/api/apex/chat/route.ts
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Get user tier from next-auth token or DB:
#
#    const token = await getToken({ req, secret: NEXTAUTH_SECRET });
#    const userTier = token?.tier ?? 'free'; // 'free' or 'pro'
#
# 2. Select the right API key:
#
#    const apiKey = userTier === 'pro' 
#      ? process.env.APEX_KEY_PRO_TIER! 
#      : process.env.APEX_KEY_FREE_TIER!;
#
# 3. Update apexHeaders() to use the selected key:
#
#    const headers = {
#      'X-API-Key': apiKey,
#      'Content-Type': 'application/json',
#    };
#
# 4. Fetch from Apex:
#
#    const apexRes = await fetch(`${APEX_BASE_URL}/chat`, {
#      method: 'POST',
#      headers,
#      body: JSON.stringify(payload),
#      signal: AbortSignal.timeout(60_000),
#    });
#
# 5. Handle HTTP 429 (quota exceeded):
#
#    if (apexRes.status === 429) {
#      return NextResponse.json(
#        { error: 'You have reached your daily request limit. Upgrade to Pro or try again tomorrow.' },
#        { status: 429 }
#      );
#    }

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring Quotas
# ─────────────────────────────────────────────────────────────────────────────
# Check daily usage with:
#
#   python evals/validate_dataset_expert.py  # or your own monitoring script
#
# Or query Apex's SQLite directly:
#
#   sqlite3 key_store.db "SELECT * FROM usage_daily ORDER BY date DESC LIMIT 10;"
#
# Daily quotas reset at 00:00 UTC (not user local time).
