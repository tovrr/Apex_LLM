# Copie ce fichier vers .env et remplace la valeur.
APEX_API_KEY=change-me-with-a-strong-secret
HF_TOKEN=
APEX_SKIP_MODEL_LOAD=1

# -----------------------------------------------------------------------------
# Optional local backend: Ollama (recommended for low-RAM CPUs)
# -----------------------------------------------------------------------------
# Leave empty to use Hugging Face backend directly.
APEX_OLLAMA_URL=http://127.0.0.1:11434
APEX_OLLAMA_MODEL_FAST=qwen3:1.7b
APEX_OLLAMA_MODEL_DEFAULT=qwen3.5:9b
APEX_OLLAMA_MODEL_REASONING=qwen3.5:27b
APEX_OLLAMA_NUM_CTX=4096

# -----------------------------------------------------------------------------
# Model routing (fast/default/reasoning)
# -----------------------------------------------------------------------------
# Tier selected when request payload does not include `model_tier`.
APEX_MODEL_DEFAULT_TIER=default

# FAST tier: low-latency default profile.
APEX_MODEL_FAST_NAME=microsoft/Phi-4-mini-instruct
# Keep empty unless the adapter was trained on this exact base model.
APEX_MODEL_FAST_LORA_DIR=

# DEFAULT tier: recommended local sweet spot (7B/8B).
# Example candidates:
# - Qwen/Qwen2.5-7B-Instruct
# - Qwen/Qwen2.5-8B-Instruct
APEX_MODEL_DEFAULT_NAME=Qwen/Qwen2.5-7B-Instruct
APEX_MODEL_DEFAULT_LORA_DIR=

# REASONING tier: heavy model for complex coding/reasoning tasks.
APEX_MODEL_REASONING_NAME=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
APEX_MODEL_REASONING_LORA_DIR=
RUNPOD_API_KEY=change-me